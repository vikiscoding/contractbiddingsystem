# Copy to repo-root .env for local development (never commit .env).
# See also: .env.example

# Storage backend: sqlite (default, day-1) | sharepoint (later activation)
STORAGE_BACKEND=sqlite

# Local data directory for SQLite DB and CSV exports
DATA_DIR=data

# Optional explicit SQLite path (default: {DATA_DIR}/contract_opportunities.db)
# SQLITE_PATH=data/contract_opportunities.db

# Logging
LOG_LEVEL=INFO

# Pipeline controls
# Create-attempt budget (default 50; 0=unlimited; negatives rejected)
# MAX_CREATE=50
# DRY_RUN is observability-only: does NOT enable writes and does NOT block --write.
# Only CLI --write persists. Default without --write is dry-run.
# DRY_RUN=true

# Keyword config path (default: config/keywords.yaml)
# KEYWORDS_PATH=config/keywords.yaml

# Zero-new streak state (default: state/zero_new_streak.json)
# STATE_PATH=state/zero_new_streak.json
# ZERO_NEW_STREAK_THRESHOLD=3

# Partial create-error exit threshold (error_count >= N → exit 1 + notify)
# PARTIAL_ERROR_EXIT_THRESHOLD=5

# Optional CanadaBuys CSV URL override
# CANADABUYS_CSV_URL=https://canadabuys.canada.ca/opendata/pub/openTenderNotice-ouvertAvisAppelOffres.csv

# --- SharePoint (only when STORAGE_BACKEND=sharepoint) ---
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# SHAREPOINT_SITE_ID=
# SHAREPOINT_LIST_ID=

# Teams Workflows webhook (recommended for failure / zero-streak alerts)
# TEAMS_WEBHOOK_URL=

# Set by GitHub Actions for Teams card "Run" fact (optional locally)
# GITHUB_RUN_URL=

# --- Google Sheets view (optional; SQLite remains system of record) ---
# pip install -e ".[sheets]"
# .env must be at REPO ROOT (not scripts/)
# GOOGLE_SHEET_ID=
# GOOGLE_SHEET_TAB=Ingest
# GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
# # CI alternative:
# GOOGLE_SERVICE_ACCOUNT_JSON=
