# Local environment template — copy to REPO ROOT .env (not scripts/.env).
# .env is gitignored; never commit secrets.
# See AGENTS.md and docs/DATA_UPDATE_DIRECTIVES.md for data rules.

# Default day-1 backend is local SQLite (no cloud secrets required).
STORAGE_BACKEND=sqlite
DATA_DIR=data
LOG_LEVEL=INFO

# SQLITE_PATH=data/contract_opportunities.db
# MAX_CREATE=50
# ZERO_NEW_STREAK_THRESHOLD=3
# PARTIAL_ERROR_EXIT_THRESHOLD=5
# KEYWORDS_PATH=config/keywords.yaml
# STATE_PATH=state/zero_new_streak.json
# TEAMS_WEBHOOK_URL=
# GITHUB_RUN_URL=
# DRY_RUN does not enable writes; only --write persists.

# Required only when STORAGE_BACKEND=sharepoint:
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# SHAREPOINT_SITE_ID=
# SHAREPOINT_LIST_ID=

# Optional Google Sheets sync (free service account + Sheets API):
# pip install -e ".[sheets]"
# GOOGLE_SHEET_ID=   # from docs.google.com/spreadsheets/d/<ID>/edit
# GOOGLE_SHEET_TAB=Ingest
# GOOGLE_SHEET_RANK_TAB=Ranked   # Grok interpret-rank full-replace tab (never Ingest)
# GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
# # or inline JSON (e.g. CI secret):
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional Grok interpret-rank (xAI API; does not mutate ingest rows):
# pip install -e ".[ai]"
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4.5
# OBJECTIVES_PATH=config/objectives.yaml

# Teams Workflows webhooks (ops alerts + high-match capture pings):
# TEAMS_WEBHOOK_URL=                 # hard fail / streak / partial (ops)
# TEAMS_MATCH_WEBHOOK_URL=           # optional dedicated capture channel; else ops URL
# TEAMS_MATCH_NOTIFY_ENABLED=true
# TEAMS_MATCH_SCORE_THRESHOLD=40     # 0–100; RelevanceScore (ingest) or Grok fit
# TEAMS_MATCH_MAX_ITEMS=8
# NOTIFY_CONFIG_PATH=config/notify.yaml
