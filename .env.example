# Local environment template — copy to .env and fill values.
# .env is gitignored; never commit secrets.

# Default day-1 backend is local SQLite (no cloud secrets required).
STORAGE_BACKEND=sqlite
DATA_DIR=data
LOG_LEVEL=INFO

# SQLITE_PATH=data/contract_opportunities.db
# MAX_CREATE=50
# ZERO_NEW_STREAK_THRESHOLD=3
# PARTIAL_ERROR_EXIT_THRESHOLD=5
# KEYWORDS_PATH=config/keywords.yaml
# STATE_PATH=state/zero_new_streak.json
# TEAMS_WEBHOOK_URL=
# GITHUB_RUN_URL=
# DRY_RUN does not enable writes; only --write persists.

# Required only when STORAGE_BACKEND=sharepoint:
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# SHAREPOINT_SITE_ID=
# SHAREPOINT_LIST_ID=
